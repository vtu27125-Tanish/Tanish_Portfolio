# Copy this file to .env and fill in your actual key.
# Get a free Groq API key at https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here

# Optional — defaults to llama-3.3-70b-versatile if not set
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — comma-separated list of frontend origins allowed to call this
# API. Defaults to the local Vite dev server if not set. Add your deployed
# frontend URL once you've deployed, e.g.:
# FRONTEND_ORIGINS=http://localhost:5173,https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:5173
