# Copy this to .env and set your backend URL.
# During local dev, the default in api.js (http://localhost:8000) works fine
# without this file. Set this when deploying so the frontend knows where
# your deployed backend lives (e.g. on Render).

VITE_API_BASE_URL=http://localhost:8000

# Optional: adds a "Book a call" button to the Contact section. Leave unset
# to hide it and use only the Gmail compose link.
# VITE_CALENDLY_URL=https://calendly.com/your-handle/intro-call
